# lyflow-rulecompiler environment (example)
# Install as /etc/lyflow/rulecompiler.env
LYFLOW_RULE_SOURCE=/var/lib/lyflow/rules/source
LYFLOW_RULE_OUTPUT=/opt/lyflow/fp-patterns/threat.json
LYFLOW_RULE_MANIFEST=/opt/lyflow/fp-patterns/manifest.json
LYFLOW_RULE_INTERVAL=2s

# Optional fallback for an unpatched ly_probe build. The LyFlow build applies
# patches/lyprobe/0001-hot-reload.patch, so this is normally empty.
# LYFLOW_RULE_RELOAD=systemctl restart lyprobe
LYFLOW_RULE_RELOAD=
