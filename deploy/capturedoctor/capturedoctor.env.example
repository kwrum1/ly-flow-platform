# lyflow-capturedoctor environment (example)
# Install as /etc/lyflow/capturedoctor.env
LYFLOW_CAPTURE_INTERFACE=ens160
LYFLOW_CAPTURE_INTERVAL=5s
LYFLOW_CAPTURE_OUTPUT=/var/lib/lyflow/capture-doctor.json
LYFLOW_CAPTURE_PROCESS=lyprobe
LYFLOW_CAPTURE_PID_FILE=

LYFLOW_CAPTURE_DROP_WARN=1.0
LYFLOW_CAPTURE_DROP_CRIT=5.0
LYFLOW_CAPTURE_RING_MIN=2048

# Restart is opt-in and never silent. Leave empty to only alert.
LYFLOW_CAPTURE_RESTART_COMMAND=
LYFLOW_CAPTURE_RESTART_AFTER=3
LYFLOW_CAPTURE_RESTART_COOLDOWN=5m

# Receives the JSON snapshot on stdin on status changes/critical events.
LYFLOW_CAPTURE_ALERT_COMMAND=
