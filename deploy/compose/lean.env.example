# LyFlow lean profile environment (example)
# Copy to lean.env and replace all change-me values before production.
# manage.sh bootstrap can generate the random secrets automatically.

POSTGRES_PASSWORD=change-me-postgres
REDIS_ACL_USERNAME=lyflow
REDIS_ACL_PASSWORD=change-me-redis
REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=change-me-clickhouse
JWT_SECRET=change-me-jwt
SECURITY_ENGINE_CONTROL_TOKEN=change-me-control
DEFAULT_ADMIN_PASSWORD=change-me-admin
LYFLOW_FORCE_FIRST_LOGIN_PASSWORD_CHANGE=true

MANAGEMENT_INTERFACE=eth0
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7.2-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8-alpine
LY_SERVER_IMAGE=ly-flow/server:latest
LY_SECURITY_ENGINE_IMAGE=ly-flow/security-engine:latest
LY_FRONTEND_IMAGE=ly-flow/frontend:latest

HTTP_BIND_PORT=80
HTTPS_BIND_PORT=443
SERVER_BIND_PORT=8080
AGENT_CENTER_BIND_PORT=8081

# Capture profile
LYPROBE_IMAGE=ly-flow/lyprobe:latest
LYFLOW_CAPTUREDOCTOR_IMAGE=ly-flow/capturedoctor:latest
LYFLOW_RULECOMPILER_IMAGE=ly-flow/rulecompiler:latest
LY_SURICATA_IMAGE=ly-flow/suricata:latest
LYPROBE_INTERFACE=ens160
LYPROBE_COLLECTOR=127.0.0.1:9995
LYPROBE_TEMPLATE=%PROTOCOL %IPV4_SRC_ADDR %IPV4_DST_ADDR %L4_SRC_PORT %L4_DST_PORT %THREAT_TYPE %THREAT_NAME %THREAT_VERS
SURICATA_INTERFACE=ens160
LYFLOW_FP_PATTERNS_DIR=./runtime/fp-patterns
LYFLOW_CAPTURE_INTERVAL=5s
LYFLOW_CAPTURE_RESTART_COMMAND=
LYFLOW_CAPTURE_ALERT_COMMAND=

# Private overlay only; leave empty for lean.
ELKEID_HUB_IMAGE=elkeid/hub:latest
ELKEID_CONSOLE_IMAGE=elkeid/console:latest
ELKEID_AGENTCENTER_IMAGE=elkeid/agentcenter:latest
ELKEID_MANAGER_IMAGE=elkeid/manager:latest
ELKEID_SERVICE_DISCOVERY_IMAGE=elkeid/service-discovery:latest
ELKEID_MONGO_IMAGE=mongo:7
ELKEID_KAFKA_IMAGE=bitnami/kafka:3.7
ELKEID_PRIVATE_DIR=../../private/elkeid
ELKEID_CONSOLE_BIND_PORT=127.0.0.1:8088
