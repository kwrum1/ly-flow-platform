# ly_probe sensor environment (example)
# Install as /etc/lyflow/lyprobe.env
LYPROBE_INTERFACE=ens160
LYPROBE_COLLECTOR=127.0.0.1:9995

# Template must include %PROTOCOL and one %THREAT_* field so the servicePlugin
# is enabled and protocol filtering in threat.json works.
LYPROBE_TEMPLATE=%PROTOCOL %IN_BYTES %IN_PKTS %IPV4_SRC_ADDR %IPV4_DST_ADDR %L4_SRC_PORT %L4_DST_PORT %THREAT_TYPE %THREAT_NAME %THREAT_VERS

# Flow lifetime/idle/queue/scan (seconds), verbose level, hash size.
LYPROBE_EXTRA_ARGS=-t 30 -d 10 -l 5 -s 5 -b 1 -w 32768
