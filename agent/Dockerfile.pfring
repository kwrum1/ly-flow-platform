FROM golang:1.26-bookworm AS builder

ARG PF_RING_REF=210a95f1445d0e2fbfd2c66088a972ed62db8cae

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential autoconf automake libtool pkg-config flex bison jq openssl libnuma-dev libpcap-dev libnl-genl-3-dev \
    && git -c http.version=HTTP/1.1 init /tmp/PF_RING \
    && git -C /tmp/PF_RING remote add origin https://github.com/ntop/PF_RING.git \
    && git -C /tmp/PF_RING -c http.version=HTTP/1.1 fetch --depth 1 origin "${PF_RING_REF}" \
    && git -C /tmp/PF_RING checkout --detach FETCH_HEAD \
    && mkdir -p /usr/local/include/linux \
    && cp /tmp/PF_RING/kernel/linux/pf_ring.h /usr/local/include/linux/pf_ring.h \
    && cd /tmp/PF_RING/userland/lib \
    && ./configure --disable-archopt --disable-ft --disable-xdp \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY agent ./agent
COPY pkg ./pkg
COPY third_party/gopacket ./third_party/gopacket
WORKDIR /src/agent
RUN CGO_ENABLED=1 go build -tags pfring -trimpath -ldflags="-s -w" -o /out/ly-agent ./cmd
RUN openssl genpkey -algorithm Ed25519 -out /tmp/agent-release.key \
    && printf '%s\n' '# Signed local mirror defaults.' 'agent:' '  log_level: info' > /out/agent.yaml \
    && public_der=/tmp/agent-release-public.der \
    && openssl pkey -in /tmp/agent-release.key -pubout -outform DER -out "$public_der" \
    && fingerprint=$(tail -c 32 "$public_der" | sha256sum | cut -d' ' -f1) \
    && for artifact in ly-agent agent.yaml; do \
         digest=$(sha256sum "/out/$artifact" | cut -d' ' -f1); \
         payload=$(jq -cn --arg artifact "$artifact" --arg digest "$digest" --arg fingerprint "$fingerprint" '{schema_version:"lyflow.signed_digest.v1",artifact:$artifact,digest:$digest,signer_fingerprint:$fingerprint}'); \
         printf '%s' "$payload" >/tmp/agent-payload.json; \
         openssl pkeyutl -sign -inkey /tmp/agent-release.key -rawin -in /tmp/agent-payload.json -out /tmp/agent-signature.bin; \
         signature=$(od -An -vtx1 /tmp/agent-signature.bin | tr -d '[:space:]'); \
         if [ "$artifact" = ly-agent ]; then output=/out/agent-binary.digest.json; else output=/out/agent-config.digest.json; fi; \
         printf '{"payload":%s,"signature":"%s"}\n' "$payload" "$signature" >"$output"; \
       done \
    && openssl pkey -in /tmp/agent-release.key -pubout -out /out/agent-integrity-root.pem \
    && rm -f /tmp/agent-release.key "$public_der" /tmp/agent-payload.json /tmp/agent-signature.bin

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpcap0.8 libnuma1 libibverbs1 libdbus-1-3 libnl-3-200 libnl-genl-3-200 libnl-route-3-200 libsystemd0 libcap2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/lib/libpfring.so* /usr/local/lib/
COPY --from=builder /out/ly-agent /app/ly-agent
COPY --from=builder /out/agent.yaml /opt/ly-agent/etc/agent.yaml
COPY --from=builder /out/agent-binary.digest.json /out/agent-config.digest.json /out/agent-integrity-root.pem /etc/lyflow/trust/
RUN ldconfig \
    && mkdir -p /opt/ly-agent/data/spool /opt/ly-agent/logs \
    && ln -s agent-integrity-root.pem /etc/lyflow/trust/agent-binary-root.pem \
    && ln -s agent-integrity-root.pem /etc/lyflow/trust/agent-config-root.pem
ENTRYPOINT ["/app/ly-agent"]
