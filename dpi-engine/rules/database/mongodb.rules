# MongoDB Detection Rules
# SID Range: 40001-40099
# Created: 2026-05-10

# NoSQL Injection Detection
alert tcp any any -> any 27017 (msg:"MongoDB NoSQL Injection - $where"; content:"$where"; nocase; sid:40001; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB NoSQL Injection - $ne"; content:"$ne"; nocase; sid:40002; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB NoSQL Injection - $or"; content:"$or"; nocase; sid:40003; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB NoSQL Injection - $gt/$lt"; content:"$gt"; nocase; sid:40004; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB NoSQL Injection - $regex"; content:"$regex"; nocase; sid:40005; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB NoSQL Injection - JavaScript Exec"; content:"$function"; nocase; sid:40006; rev:1;)

# Unauthorized Access
alert tcp any any -> any 27017 (msg:"MongoDB Unauthorized - Admin Command"; content:"admin"; nocase; sid:40007; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Unauthorized - Admin Database"; content:"$external"; nocase; sid:40008; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Unauthorized - noauth Mode"; content:"authMechanism"; nocase; sid:40009; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Unauthorized - Anonymous Login"; content:"\"user\":\"\""; nocase; sid:40010; rev:1;)

# Brute Force Detection
alert tcp any any -> any 27017 (msg:"MongoDB Brute Force - Multiple Auth Fail"; threshold:type threshold, track by_src, count 10, seconds 60; sid:40011; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Brute Force - Failed Auth"; content:"Authentication failed"; nocase; sid:40012; rev:1;)

# Malicious Commands
alert tcp any any -> any 27017 (msg:"MongoDB Malicious - dropDatabase"; content:"dropDatabase"; nocase; sid:40013; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Malicious - dropCollection"; content:"drop"; nocase; sid:40014; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Malicious - serverStatus"; content:"serverStatus"; nocase; sid:40015; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Malicious - shutdown"; content:"shutdown"; nocase; sid:40016; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Malicious - eval JS"; content:"eval"; nocase; sid:40017; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Malicious - copydb"; content:"copydb"; nocase; sid:40018; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Malicious - cloneCollection"; content:"cloneCollection"; nocase; sid:40019; rev:1;)

# Data Exfiltration
alert tcp any any -> any 27017 (msg:"MongoDB Exfil - listCollections"; content:"listCollections"; nocase; sid:40020; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Exfil - listIndexes"; content:"listIndexes"; nocase; sid:40021; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Exfil - find All"; content:"find"; nocase; sid:40022; rev:1;)
alert tcp any any -> any 27017 (msg:"MongoDB Exfil - aggregate"; content:"aggregate"; nocase; sid:40023; rev:1;)