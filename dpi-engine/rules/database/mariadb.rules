# MariaDB Detection Rules
# SID Range: 60001-60099
# Created: 2026-05-10
# Note: MariaDB is compatible with MySQL protocol (port 3306)

# SQL Injection Detection
alert tcp any any -> any 3306 (msg:"MariaDB SQL Injection - UNION SELECT"; content:"UNION|20SELECT"; nocase; sid:60001; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB SQL Injection - OR 1=1"; content:"OR|201=1"; nocase; sid:60002; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB SQL Injection - ST_GeomFromText"; content:"ST_GeomFromText"; nocase; sid:60003; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB SQL Injection - JSON Functions"; content:"JSON_EXTRACT"; nocase; sid:60004; rev:1;)

# MariaDB-specific Exploits
alert tcp any any -> any 3306 (msg:"MariaDB Exploit - Spider Engine"; content:"Spider"; nocase; sid:60005; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Exploit - Cassandra Interface"; content:"cassandra"; nocase; sid:60006; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Exploit - CONNECT Engine"; content:"CONNECT"; nocase; sid:60007; rev:1;)

# Brute Force Detection
alert tcp any any -> any 3306 (msg:"MariaDB Brute Force - Multiple Connections"; threshold:type threshold, track by_src, count 10, seconds 60; sid:60008; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Brute Force - Failed Login"; content:"Access denied"; nocase; sid:60009; rev:1;)

# Unauthorized Access
alert tcp any any -> any 3306 (msg:"MariaDB Unauthorized - Anonymous User"; content:"Access denied for user ''"; nocase; sid:60010; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Unauthorized - Empty Password"; content:"Access denied for user"; nocase; sid:60011; rev:1;)

# Malicious Commands
alert tcp any any -> any 3306 (msg:"MariaDB Malicious - KILL Statement"; content:"KILL|20"; nocase; sid:60012; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Malicious - SHUTDOWN"; content:"SHUTDOWN"; nocase; sid:60013; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Malicious - XA Transactions"; content:"XA"; nocase; sid:60014; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Malicious - SET GLOBAL"; content:"SET|20GLOBAL"; nocase; sid:60015; rev:1;)

# Data Exfiltration
alert tcp any any -> any 3306 (msg:"MariaDB Exfil - SELECT All"; content:"SELECT|20*"; nocase; sid:60016; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Exfil - INTO OUTFILE"; content:"INTO|20OUTFILE"; nocase; sid:60017; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Exfil - Information Schema"; content:"INFORMATION_SCHEMA"; nocase; sid:60018; rev:1;)
alert tcp any any -> any 3306 (msg:"MariaDB Exfil - Performance Schema"; content:"PERFORMANCE_SCHEMA"; nocase; sid:60019; rev:1;)