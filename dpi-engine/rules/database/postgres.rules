# PostgreSQL Detection Rules
# SID Range: 20001-20099
# Created: 2026-05-10

# SQL Injection Detection
alert tcp any any -> any 5432 (msg:"PostgreSQL SQL Injection - UNION SELECT"; content:"UNION|20SELECT"; nocase; sid:20001; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL SQL Injection - CAST Statement"; content:"CAST("; nocase; sid:20002; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL SQL Injection - EXTRACT"; content:"EXTRACT("; nocase; sid:20003; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL SQL Injection - LIKE Escape"; content:"LIKE|20"; nocase; sid:20004; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL SQL Injection - Subselect"; content:"SELECT|20"; nocase; sid:20005; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL SQL Injection - COPY Command"; content:"COPY"; nocase; sid:20006; rev:1;)

# Brute Force Detection
alert tcp any any -> any 5432 (msg:"PostgreSQL Brute Force - Multiple Connections"; threshold:type threshold, track by_src, count 10, seconds 60; sid:20007; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Brute Force - Failed Authentication"; content:"password authentication failed"; nocase; sid:20008; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Brute Force - Failed Login Count"; threshold:type threshold, track by_src, count 5, seconds 60; sid:20009; rev:1;)

# Unauthorized Access
alert tcp any any -> any 5432 (msg:"PostgreSQL Unauthorized - No Password"; content:"no password was supplied"; nocase; sid:20010; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Unauthorized - Invalid Database"; content:"does not exist"; nocase; sid:20011; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Unauthorized - Invalid User"; content:"no such user"; nocase; sid:20012; rev:1;)

# Malicious Commands
alert tcp any any -> any 5432 (msg:"PostgreSQL Malicious - pg_sleep"; content:"pg_sleep"; nocase; sid:20013; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Malicious - COPY TO/FROM"; content:"COPY|20"; nocase; sid:20014; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Malicious - system() Call"; content:"system("; nocase; sid:20015; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Malicious - inet_server_addr"; content:"inet_server_addr"; nocase; sid:20016; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Malicious - lo_import"; content:"lo_import"; nocase; sid:20017; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Malicious - pg_read_file"; content:"pg_read_file"; nocase; sid:20018; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Malicious - pg_execute_server_program"; content:"pg_execute_server_program"; nocase; sid:20019; rev:1;)

# Database Enumeration
alert tcp any any -> any 5432 (msg:"PostgreSQL Recon - List Databases"; content:"datname|20FROM|20pg_database"; nocase; sid:20020; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Recon - List Users"; content:"usename|20FROM|20pg_user"; nocase; sid:20021; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Recon - List Tables"; content:"tablename|20FROM|20pg_tables"; nocase; sid:20022; rev:1;)
alert tcp any any -> any 5432 (msg:"PostgreSQL Recon - Version Info"; content:"version()"; nocase; sid:20023; rev:1;)