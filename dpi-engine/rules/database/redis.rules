# Redis Detection Rules
# SID Range: 30001-30099
# Created: 2026-05-10

# Unauthorized Access
alert tcp any any -> any 6379 (msg:"Redis Unauthorized - MONITOR Command"; content:"MONITOR"; nocase; sid:30001; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Unauthorized - DEBUG Command"; content:"DEBUG"; nocase; sid:30002; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Unauthorized - CONFIG Command"; content:"CONFIG"; nocase; sid:30003; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Unauthorized - OBJECT Command"; content:"OBJECT"; nocase; sid:30004; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Unauthorized - Client List"; content:"CLIENT|20LIST"; nocase; sid:30005; rev:1;)

# Malicious Commands
alert tcp any any -> any 6379 (msg:"Redis Malicious - FLUSHALL"; content:"FLUSHALL"; nocase; sid:30006; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Malicious - FLUSHDB"; content:"FLUSHDB"; nocase; sid:30007; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Malicious - SLAVEOF NO ONE"; content:"SLAVEOF|20NO|20ONE"; nocase; sid:30008; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Malicious - SHUTDOWN"; content:"SHUTDOWN"; nocase; sid:30009; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Malicious - KEYS Pattern"; content:"KEYS|20*"; nocase; sid:30010; rev:1;)

# Lua Script Exploitation
alert tcp any any -> any 6379 (msg:"Redis Lua Exploit - EVAL Command"; content:"EVAL"; nocase; sid:30011; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Lua Exploit - EVALSHA"; content:"EVALSHA"; nocase; sid:30012; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Lua Exploit - SCRIPT LOAD"; content:"SCRIPT|20LOAD"; nocase; sid:30013; rev:1;)

# Connection Anomalies
alert tcp any any -> any 6379 (msg:"Redis Anomaly - Mass Connections"; threshold:type threshold, track by_src, count 50, seconds 10; sid:30014; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Anomaly - Large KEYS Scan"; content:"SCAN"; nocase; sid:30015; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Anomaly - Long Command"; content:"|20"; pcre:"/\|[a-z]{50,}/i"; sid:30016; rev:1;)

# Data Exfiltration
alert tcp any any -> any 6379 (msg:"Redis Exfil - DUMP Command"; content:"DUMP"; nocase; sid:30017; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Exfil - GET Multiple Keys"; content:"GET"; nocase; sid:30018; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Exfil - Full Redis Dump"; content:"GET|20"; nocase; sid:30019; rev:1;)

# Authentication Bypass
alert tcp any any -> any 6379 (msg:"Redis Auth Bypass - No Auth Required"; content:"PING"; nocase; sid:30020; rev:1;)
alert tcp any any -> any 6379 (msg:"Redis Auth Bypass - Anonymous Access"; content:"AUTH"; nocase; sid:30021; rev:1;)