# MySQL Detection Rules
# SID Range: 10001-10099
# Created: 2026-05-10

# SQL Injection Detection
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - UNION SELECT"; content:"UNION|20SELECT"; nocase; sid:10001; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - OR 1=1"; content:"OR|201=1"; nocase; sid:10002; rev:1;)
alert tcp tcp any any -> any 3306 (msg:"MySQL SQL Injection - DROP TABLE"; content:"DROP|20TABLE"; nocase; sid:10003; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - INTO OUTFILE"; content:"INTO|20OUTFILE"; nocase; sid:10004; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - LOAD FILE"; content:"LOAD|20FILE"; nocase; sid:10005; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - SLEEP"; content:"SLEEP("; nocase; sid:10006; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - BENCHMARK"; content:"BENCHMARK("; nocase; sid:10007; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - WAITFOR DELAY"; content:"WAITFOR|20DELAY"; nocase; sid:10008; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - EXECUTE"; content:"EXECUTE"; nocase; sid:10009; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL SQL Injection - INFORMATION_SCHEMA"; content:"INFORMATION_SCHEMA"; nocase; sid:10010; rev:1;)

# Brute Force Detection
alert tcp any any -> any 3306 (msg:"MySQL Brute Force - Multiple Connections"; threshold:type threshold, track by_src, count 10, seconds 60; sid:10011; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Brute Force - Failed Login"; content:"Access denied"; nocase; sid:10012; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Brute Force - Root Login Attempt"; content:"root"; nocase; sid:10013; rev:1;)

# Unauthorized Access
alert tcp any any -> any 3306 (msg:"MySQL Unauthorized - Empty Password Login"; content:"Access denied for user"; nocase; sid:10014; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Unauthorized - Invalid User"; content:"Access denied for user 'test'"; nocase; sid:10015; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Unauthorized - Anonymous Login"; content:"Access denied for user ''"; nocase; sid:10016; rev:1;)

# Malicious Commands
alert tcp any any -> any 3306 (msg:"MySQL Malicious - System Command Exec"; content:"system("; nocase; sid:10017; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Malicious - exec() Call"; content:"exec("; nocase; sid:10018; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Malicious - SHUTDOWN Command"; content:"SHUTDOWN"; nocase; sid:10019; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Malicious - KILL Statement"; content:"KILL|20"; nocase; sid:10020; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Malicious - SHUTDOWN Command"; content:"SHUTDOWN"; nocase; sid:10021; rev:1;)

# Data Exfiltration
alert tcp any any -> any 3306 (msg:"MySQL Data Exfil - Large SELECT"; content:"SELECT|20*|20FROM"; nocase; sid:10022; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Data Exfil - INTO DUMPFILE"; content:"INTO|20DUMPFILE"; nocase; sid:10023; rev:1;)
alert tcp any any -> any 3306 (msg:"MySQL Data Exfil - HEX Encoding"; content:"0x"; pcre:"/0x[a-f0-9]{32,}/i"; sid:10024; rev:1;)