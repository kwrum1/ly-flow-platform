    "pinia": "2.3.1",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.6.2",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "^26.1.0",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "vite": "5.4.21",
