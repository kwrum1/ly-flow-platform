+void SrvPlugin_init(int argc, char *argv[]) {
+  (void)argc;
+  (void)argv;
+  if(readOnlyGlobals.traceMode) traceEvent(TRACE_NORMAL, "Initialized servicePlugin");
+
+  struct common_pat_info *new_patterns[PAT_TYPE_NUM] = {0};
+  int num_patterns = loadAllPatterns(new_patterns);
+  if(num_patterns < 0) {
+    traceEvent(TRACE_ERROR, "Unable to load patterns; servicePlugin disabled.");
+    return;
+  }
+
+  pthread_rwlock_wrlock(&patternsRwLock);
+  freeAllPatterns();
+  int i;
+  for(i = 0; i < PAT_TYPE_NUM; i++) patterns[i] = new_patterns[i];
+  pthread_rwlock_unlock(&patternsRwLock);
+
+  traceEvent(TRACE_NORMAL, ">>Loaded %d patterns totally.", num_patterns);
+  if(activePatternDir[0] != '\0' && !patternsWatcherStarted) {
+    patternsWatcherStarted = 1;
+    if(pthread_create(&patternsWatcher, NULL, patternsWatcherThread, NULL) == 0) {
+      pthread_detach(patternsWatcher);
+    } else {
+      patternsWatcherStarted = 0;
+      traceEvent(TRACE_WARNING, "Unable to start pattern watcher.");
+    }
+  }
+}
