+static void *patternsWatcherThread(void *unused) {
+  unsigned long long last = patternStamp();
+  (void)unused;
+  while(1) {
+    sleep(2);
+    unsigned long long now = patternStamp();
+    if(now == last) continue;
+    last = now;
+    struct common_pat_info *new_patterns[PAT_TYPE_NUM] = {0};
+    int total = loadAllPatterns(new_patterns);
+    if(total < 0) {
+      traceEvent(TRACE_ERROR, "Hot reload failed; keeping previous patterns.");
+      continue;
+    }
+    pthread_rwlock_wrlock(&patternsRwLock);
+    freeAllPatterns();
+    int i;
+    for(i = 0; i < PAT_TYPE_NUM; i++) patterns[i] = new_patterns[i];
+    pthread_rwlock_unlock(&patternsRwLock);
+    traceEvent(TRACE_NORMAL, "Hot-reloaded %d patterns from %s.", total, activePatternDir);
+  }
+  return NULL;
 }
 
