-include ly_rasp.dep
ly_rasp.lo: /root/ly-flow-platform/probe/rasp/php/extension/ly_rasp.c
	$(LIBTOOL) --tag=CC --mode=compile $(CC) -I. -I/root/ly-flow-platform/probe/rasp/php/extension $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS)   -DZEND_COMPILE_DL_EXT=1 -c /root/ly-flow-platform/probe/rasp/php/extension/ly_rasp.c -o ly_rasp.lo  -MMD -MF ly_rasp.dep -MT ly_rasp.lo
$(phplibdir)/ly_rasp.la: ./ly_rasp.la
	$(LIBTOOL) --tag=CC --mode=install cp ./ly_rasp.la $(phplibdir)

./ly_rasp.la: $(shared_objects_ly_rasp) $(LY_RASP_SHARED_DEPENDENCIES)
	$(LIBTOOL) --tag=CC --mode=link $(CC) -shared $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS)  -o $@ -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_ly_rasp) $(LY_RASP_SHARED_LIBADD)

