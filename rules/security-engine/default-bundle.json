{
  "version": "default-dev-bundle-v4",
  "rules": [
    {
      "id": "rasp-sqli-default",
      "name": "RASP SQL Injection Signal",
      "category": "rasp",
      "severity": "critical",
      "score_hint": 90,
      "stage_hint": "initial_access",
      "field": "query",
      "value": "(?i)(union\\s+select|or\\s+1=1|sleep\\s*\\(|information_schema)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "rasp-command-exec-default",
      "name": "RASP Command Execution Signal",
      "category": "rasp",
      "severity": "high",
      "score_hint": 82,
      "stage_hint": "execution",
      "field": "command",
      "value": "(?i)(/bin/sh|/bin/bash|cmd\\.exe|powershell|whoami|curl\\s+http)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "runtime-reverse-shell-default",
      "name": "Runtime Reverse Shell Signal",
      "category": "runtime",
      "severity": "high",
      "score_hint": 80,
      "stage_hint": "execution",
      "field": "cmdline",
      "value": "/dev/tcp",
      "regex": false,
      "candidate": true
    },
    {
      "id": "runtime-credential-dump-default",
      "name": "Runtime Credential Access Signal",
      "category": "runtime",
      "severity": "high",
      "score_hint": 78,
      "stage_hint": "credential_access",
      "field": "cmdline",
      "value": "(?i)(/etc/shadow|mimikatz|procdump|lsass|credential)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "runtime-suspicious-download-default",
      "name": "Runtime Suspicious Downloader",
      "category": "runtime",
      "severity": "medium",
      "score_hint": 62,
      "stage_hint": "execution",
      "field": "cmdline",
      "value": "(?i)((curl|wget)[^|;]*https?://[^|;]*(\\|\\s*(sh|bash|python|perl)\\b|-O\\s+/(tmp|dev/shm|var/tmp)/))|(python[0-9.]*\\s+-c\\s+.*(urlopen|requests\\.get))",
      "regex": true,
      "candidate": true
    },
    {
      "id": "log-ssh-failure-default",
      "name": "SSH Authentication Failure Log",
      "category": "log_audit",
      "severity": "medium",
      "score_hint": 55,
      "stage_hint": "initial_access",
      "field": "message",
      "value": "(?i)(failed password|invalid user|authentication failure)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "log-privilege-escalation-default",
      "name": "Privilege Escalation Log Signal",
      "category": "log_audit",
      "severity": "high",
      "score_hint": 74,
      "stage_hint": "privilege_escalation",
      "field": "message",
      "value": "(?i)(useradd|usermod|groupadd|groupmod|visudo|setcap|passwd\\s+\\S+|chmod\\s+[0-7]*7[0-7][0-7]|chown\\s+root|sudo:.*COMMAND=.*(useradd|usermod|passwd|visudo|chmod\\s+777|chown\\s+root|setcap))",
      "regex": true,
      "candidate": true
    },
    {
      "id": "dpi-scanner-user-agent-default",
      "name": "DPI Scanner User Agent",
      "category": "traffic",
      "severity": "medium",
      "score_hint": 56,
      "stage_hint": "recon",
      "field": "user_agent",
      "value": "(?i)(sqlmap|nikto|nmap|masscan|zgrab)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "dpi-c2-domain-default",
      "name": "DPI Suspicious C2 Domain",
      "category": "traffic",
      "severity": "high",
      "score_hint": 76,
      "stage_hint": "c2_exfiltration",
      "field": "domain",
      "value": "(?i)(^|\\.)(malware|miner|ransom|stealer|botnet|c2)(\\.|$)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "artifact-yara-health-default",
      "name": "YARA File Scanner Health Match",
      "category": "artifact",
      "severity": "low",
      "score_hint": 25,
      "stage_hint": "detection",
      "field": "rule",
      "value": "LyFlow.Agent.FileScanner.Health",
      "regex": false,
      "candidate": true
    },
    {
      "id": "artifact-yara-malware-default",
      "name": "YARA Malware Family Match",
      "category": "artifact",
      "severity": "high",
      "score_hint": 78,
      "stage_hint": "execution",
      "field": "rule",
      "value": "(?i)(malware|trojan|webshell|miner|ransom)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "log-nginx-sqli-default",
      "name": "Nginx SQL Injection Log Signal",
      "category": "log_audit",
      "severity": "high",
      "score_hint": 65,
      "stage_hint": "initial_access",
      "field": "message",
      "value": "(?i)(union\\s+select|or\\s+1=1|information_schema|sleep\\s*\\()",
      "regex": true,
      "candidate": true
    },
    {
      "id": "log-nginx-xss-default",
      "name": "Nginx XSS Log Signal",
      "category": "log_audit",
      "severity": "medium",
      "score_hint": 50,
      "stage_hint": "initial_access",
      "field": "message",
      "value": "(?i)(<script|javascript:|onerror=|onload=)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "log-nginx-traversal-default",
      "name": "Nginx Path Traversal Log Signal",
      "category": "log_audit",
      "severity": "high",
      "score_hint": 60,
      "stage_hint": "discovery",
      "field": "message",
      "value": "(\\.\\./|%2e%2e)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "log-nginx-scanner-default",
      "name": "Nginx Web Scanner Log Signal",
      "category": "log_audit",
      "severity": "medium",
      "score_hint": 45,
      "stage_hint": "recon",
      "field": "message",
      "value": "(?i)(sqlmap|nikto|nmap|masscan|acunetix|burp|nessus)",
      "regex": true,
      "candidate": true
    },
    {
      "id": "log-nginx-cmdi-default",
      "name": "Nginx Command Injection Log Signal",
      "category": "log_audit",
      "severity": "high",
      "score_hint": 65,
      "stage_hint": "execution",
      "field": "message",
      "value": "(?i)(;|\\||&&|`|\\$\\()[^\\s]*(cat|id|whoami|wget|curl)",
      "regex": true,
      "candidate": true
    }
  ]
}
