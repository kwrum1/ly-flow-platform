<group name="auditd,linux,">
  <rule id="5901" level="10">
    <decoded_as>auditd</decoded_as>
    <match>Accepted password for root</match>
    <description>Root SSH login accepted</description>
    <group>authentication_success,pci_dss_10.2.5,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>
  <rule id="5902" level="7">
    <decoded_as>auditd</decoded_as>
    <match>sudo: pam_unix(sudo:auth): authentication failure</match>
    <description>Sudo authentication failure</description>
    <group>authentication_failed,privilege_escalation,</group>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>
  <rule id="5903" level="10">
    <decoded_as>auditd</decoded_as>
    <match>useradd</match>
    <description>Linux user account created</description>
    <group>account_changed,persistence,</group>
    <mitre>
      <id>T1136</id>
    </mitre>
  </rule>
  <rule id="5999" level="5">
    <decoded_as>auditd</decoded_as>
    <field>audit.auid</field>
    <description>Unsupported audit auid field fixture</description>
    <group>auditd,unsupported,</group>
  </rule>
</group>
