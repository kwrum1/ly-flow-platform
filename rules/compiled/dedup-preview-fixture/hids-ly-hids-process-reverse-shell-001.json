  "id": "ly-hids-process-reverse-shell-001",
  "name": "反弹 Shell 进程行为",
  "description": "检测 bash/sh/nc 等进程参数中的交互式反弹 Shell 特征。",
  "category": "hids",
  "enabled": true,
  "source": {
    "origin": "internal",
    "vendor": "LyFlow",
    "license": "Proprietary",
    "url": "lyflow://rules/internal/hids",
    "version": "2026.05",
