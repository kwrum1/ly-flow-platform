    "conversion_version": "v1",
    "raw_path": "rules/internal/hids/lyflow/",
    "converted_path": "rules/compiled/hids/"
  },
  "support": {
    "level": "full_supported",
    "unsupported_fields": [],
    "notes": [
      "Uses process command line fields emitted by the current LyFlow agent."
    ]
  },
  "classification": {
    "stage": "execution",
    "mitre_tactics": [
      "TA0002"
    ],
    "mitre_techniques": [
      "T1059"
    ],
    "confidence": 0.9,
    "rationale": "Interactive shell process patterns are execution-stage indicators."
  },
  "scoring": {
    "base_score": 82,
    "severity": "high",
    "source_reliability": 95
  },
  "match": {
    "logic": "any",
    "entities": [
      "host.id",
      "process.pid",
      "user.name"
    ],
    "conditions": [
      {
        "field": "process.command_line",
        "operator": "regex",
        "value": "(?i)(bash|sh).*(-i|/dev/tcp|/dev/udp)"
      },
      {
        "field": "process.command_line",
        "operator": "regex",
        "value": "(?i)(nc|ncat|socat).*(-e|exec|/bin/sh|/bin/bash)"
      }
    ]
  },
