    content:"Chopper"; nocase; \
    content:"aspxspy"; nocase; \
    classtype:web-application-attack; sid:9004304; rev:1;)

# ============ Encoding WebShell ============

# Base64 Encoded Command POST
alert http any any -> any any (msg:"[LY-WSHELL-ENC-001] Base64 Encoded Command POST"; \
    method:POST; \
    content:"Content-Type: application/x-www-form-urlencoded"; \
    pcre:"/[A-Za-z0-9+\/]{50,}={0,2}$/"; \
    threshold:type threshold, track by_src, count 5, seconds 60; \
    classtype:web-application-attack; sid:9004401; rev:1;)

# Rot13 Encoding Pattern
alert http any any -> any any (msg:"[LY-WSHELL-ENC-002] Rot13 Encoding Pattern"; \
    content:"str_rot13"; nocase; \
    classtype:web-application-attack; sid:9004402; rev:1;)

# ============ reGeorg/Neo-reGeorg ============

# reGeorg WebSocket Tunnel
alert http any any -> any any (msg:"[LY-WSHELL-RG-001] reGeorg WebSocket Tunnel"; \
    content:"Upgrade"; nocase; \
    content:"websocket"; nocase; \
    content:"/~!frp"; nocase; \
    flow:established,to_server; \
    classtype:trojan-activity; sid:9004501; rev:1;)

# Neo-reGeorg Session Pattern
alert http any any -> any any (msg:"[LY-WSHELL-RG-002] Neo-reGeorg Session Pattern"; \
    method:POST; \
    content:"nance"; nocase; \
    content:"sessionid"; nocase; \
    threshold:type threshold, track by_src, count 10, seconds 60; \
    classtype:trojan-activity; sid:9004502; rev:1;)

# ============ Godzilla WebShell ============

# Godzilla WebShell
alert http any any -> any any (msg:"[LY-WSHELL-GZ-001] Godzilla WebShell Pattern"; \
    content:"pass"; nocase; \
    content:"key"; nocase; \
    content:"AES"; nocase; \
    threshold:type threshold, track by_src, count 5, seconds 60; \
    classtype:web-application-attack; sid:9004601; rev:1;)

