# 流影自定义安全规则 - WebShell检测
# 版本: 1.0.0
# 更新时间: 2026-05-09
# 说明: 检测各类WebShell特征

# ============ PHP WebShell ============

# PHP eval base64_decode
alert http any any -> any any (msg:"[LY-WSHELL-PHP-001] PHP eval base64_decode WebShell"; \
    method:POST; \
    content:"eval"; nocase; \
    content:"base64_decode"; nocase; \
    classtype:web-application-attack; sid:9004001; rev:1;)

# PHP system exec
alert http any any -> any any (msg:"[LY-WSHELL-PHP-002] PHP system exec WebShell"; \
    method:POST; \
    content:"system"; nocase; \
    content:"exec"; nocase; \
    content:"passthru"; nocase; \
    classtype:web-application-attack; sid:9004003; rev:1;)

# PHP assert function
alert http any any -> any any (msg:"[LY-WSHELL-PHP-003] PHP assert WebShell"; \
    method:POST; \
    content:"assert"; nocase; \
    content:"base64"; nocase; \
    classtype:web-application-attack; sid:9004003; rev:1;)

# PHP create_function
alert http any any -> any any (msg:"[LY-WSHELL-PHP-004] PHP create_function Hook"; \
    method:POST; \
    content:"create_function"; nocase; \
    classtype:web-application-attack; sid:9004004; rev:1;)

# PHP preg_replace eval
alert http any any -> any any (msg:"[LY-WSHELL-PHP-005] PHP preg_replace e modifier"; \
    method:POST; \
    content:"preg_replace"; nocase; \
    content:"/.*/e"; nocase; \
    classtype:web-application-attack; sid:9004005; rev:1;)

# ============ JSP WebShell ============

# JSP Runtime getRuntime
alert http any any -> any any (msg:"[LY-WSHELL-JSP-001] JSP Runtime getRuntime Execution"; \
    method:POST; \
    content:"Runtime"; \
    content:"getRuntime"; \
    content:"exec"; \
    classtype:web-application-attack; sid:9004101; rev:1;)

# JSP ProcessBuilder
alert http any any -> any any (msg:"[LY-WSHELL-JSP-002] JSP ProcessBuilder Execution"; \
    method:POST; \
    content:"ProcessBuilder"; \
    classtype:web-application-attack; sid:9004102; rev:1;)

# JSP Reverse Shell
alert http any any -> any any (msg:"[LY-WSHELL-JSP-003] JSP Reverse Shell Pattern"; \
    method:POST; \
    content:"Socket"; \
    content:"BufferedReader"; \
    content:"InputStreamReader"; \
    classtype:web-application-attack; sid:9004103; rev:1;)

