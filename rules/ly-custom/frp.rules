# 流影自定义安全规则 - FRP内网穿透检测
# 版本: 1.0.0
# 更新时间: 2026-05-09
# 说明: 检测FRP内网穿透工具特征

# FRP Control Port Access - JSON Version Info
alert tcp any any -> any 7000 (msg:"[LY-FRP-001] FRP Control Port JSON Version Detection"; \
    content:"{\"version\":"; nocase; \
    content:"\"os\":"; nocase; \
    content:"\"arch\":"; nocase; \
    classtype:trojan-activity; sid:9001001; rev:1;)

# FRP Authentication Token
alert tcp any any -> any 7000 (msg:"[LY-FRP-002] FRP Authentication Token Detection"; \
    content:"privilege_key"; nocase; \
    classtype:trojan-activity; sid:9001002; rev:1;)

# FRP Run ID
alert tcp any any -> any 7000 (msg:"[LY-FRP-003] FRP Run ID Detection"; \
    content:"\"run_id\":"; nocase; \
    classtype:trojan-activity; sid:9001003; rev:1;)

# FRP WebSocket Tunnel Path
alert tcp any any -> any any (msg:"[LY-FRP-004] FRP WebSocket Path /~!frp"; \
    content:"/~!frp"; \
    flow:established,to_server; \
    classtype:trojan-activity; sid:9001004; rev:1;)

# FRP TLS Control Connection (default port 7000)
# The previous rule matched TLS record 0x17 03 (application data), which is
# present in every TLS 1.2 session and therefore fired on normal HTTPS.
# FRP's TLS mode is indistinguishable from TLS without DPI on the control
# channel, so scope the rule to the default FRP control port instead.
alert tls any any -> any 7000 (msg:"[LY-FRP-005] FRP TLS Control Connection on Port 7000"; \
    flow:established,to_server; \
    threshold:type limit, track by_src, count 1, seconds 300; \
    classtype:trojan-activity; sid:9001005; rev:2;)

# FRP Pool Count
alert tcp any any -> any 7000 (msg:"[LY-FRP-006] FRP Pool Count Field"; \
    content:"\"pool_count\":"; nocase; \
    classtype:trojan-activity; sid:9001006; rev:1;)

# FRP Enable TLS Configuration
alert tcp any any -> any any (msg:"[LY-FRP-007] FRP TLS Enable Configuration"; \
    content:"tls_enable"; nocase; \
    content:"true"; nocase; \
    classtype:trojan-activity; sid:9001007; rev:1;)

# FRP Version 0.48.x Specific Pattern
alert tcp any any -> any 7000 (msg:"[LY-FRP-008] FRP Version 0.48 Detection"; \
    content:"0.48"; \
    content:"windows"; nocase; \
    classtype:trojan-activity; sid:9001008; rev:1;)

# FRP HTTP Proxy Basic Auth
# Only client->server proxy requests carry Proxy-Authorization. The previous
# rule had no direction and also matched server responses and normal proxy
# traffic, producing false positives on internal proxy auth.
alert http any any -> any any (msg:"[LY-FRP-009] FRP HTTP Proxy Basic Auth"; \
    flow:established,to_server; \
    http.request_header; content:"Proxy-Authorization"; nocase; \
    http.request_header; content:"Basic"; nocase; \
    threshold:type limit, track by_src, count 1, seconds 60; \
    classtype:trojan-activity; sid:9001009; rev:2;)

# FRP Custom Subdomain
alert tcp any any -> any any (msg:"[LY-FRP-010] FRP Custom Subdomain Pattern"; \
    content:"\"subdomain\":"; nocase; \
    content:"custom_domains"; nocase; \
    classtype:trojan-activity; sid:9001010; rev:1;)
